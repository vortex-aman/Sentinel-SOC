<group name="windows,sysmon,custom">

    <!-- Detect net user -->

    <rule id="100001" level="8">
        <if_group>sysmon_event1</if_group>
        <field name="win.eventdata.image">(?i)cmd.exe</field>
        <field name="win.eventdata.commandLine">.*net user.*</field>
        <description>Account Discovery detected using net user</description>
        <mitre>
            <id>T1087</id>
        </mitre>
    </rule>

    <!-- Detect whoami -->

    <rule id="100002" level="6">
        <if_group>sysmon_event1</if_group>
        <field name="win.eventdata.commandLine">.*whoami.*</field>
        <description>User Discovery detected using whoami</description>
        <mitre>
            <id>T1033</id>
        </mitre>
    </rule>

</group>
